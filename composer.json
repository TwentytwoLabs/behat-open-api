{
    "name": "twentytwo-labs/behat-open-api",
    "description": "Behat contexts",
    "keywords": ["Behat", "Symfony", "OpenApi", "Swagger"],
    "type": "library",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "TwentytwoLabs\\BehatOpenApiExtension\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TwentytwoLabs\\BehatOpenApiExtension\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --stop-on-failure --stop-on-error",
        "test-coverage": "vendor/bin/phpunit --only-summary-for-coverage-text --coverage-html=coverage --coverage-xml=coverage/coverage-xml --log-junit=coverage/junit.xml --coverage-text --colors=always --stop-on-failure --stop-on-error && vendor/bin/infection --threads=4 --coverage=coverage",
        "cs": "vendor/bin/phpcs --standard=PSR12 src",
        "cs-fixer": "vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --dry-run --using-cache=no src",
        "cs-fixer-apply": "./vendor/friendsofphp/php-cs-fixer/php-cs-fixer fix --using-cache=no src",
        "phpstan": "./vendor/bin/phpstan analyse"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "behat/behat": "^3.0",
        "friends-of-behat/mink-extension": "^2.6",
        "guzzlehttp/psr7": "^2.3",
        "symfony/http-foundation": "^6.0|^7.0|^8.0",
        "symfony/property-access": "^6.0|^7.0|^8.0",
        "symfony/serializer": "^6.0|^7.0|^8.0",
        "twentytwo-labs/api-validator": "^2.0",
        "twentytwo-labs/array-comparator": "^1.0",
        "webmozart/assert": "^1.11|^2.0"
    },
    "require-dev": {
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.8",
        "infection/infection": "^0.29|^0.35",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "squizlabs/php_codesniffer": "^3.13"
    }
}
